# Webapp Environment Configuration

# Server API URL (REQUIRED)
# The URL of the backend server for pronunciation analysis
# For local development: http://localhost:3000
# For production: your deployed server URL (e.g., https://your-backend.herokuapp.com)
API_URL=http://localhost:3000

# Note: API keys should NEVER be included in the webapp configuration
# for security reasons. Keep all API keys on the server side only.
# See server/.env for server-side API key configuration.
