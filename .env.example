# Webapp Environment Configuration

# Server API URL (REQUIRED)
# The URL of the backend server for pronunciation analysis
# For local development: http://localhost:3000
# For production: your deployed server URL
API_URL=http://localhost:3000

# Gemini API Key (OPTIONAL - for client-side use, NOT RECOMMENDED for production)
# It's more secure to keep API keys on the server only
# Leave empty to use server-side API key only
API_KEY=
