# Server Environment Configuration

# Gemini API Key (REQUIRED)
# Get your key from Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model (using 2.5 flash as recommended, but other options available)
# Options: gemini-2.5-flash (default, recommended), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Gemini API URL (optional, defaults to official endpoint)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Server Port (optional, defaults to 3000)
PORT=3000

# Use Forced Aligner (optional, defaults to false)
# Set to 'true' to use Montreal Forced Aligner or Gentle
# NOTE: Aligner must be installed separately (see README)
USE_FORCED_ALIGNER=false

# Forced Aligner Type (optional, used if USE_FORCED_ALIGNER=true)
# Options: 'mfa' (Montreal Forced Aligner) or 'gentle'
ALIGNER_TYPE=mfa

# MFA Dictionary Path (optional, used if ALIGNER_TYPE=mfa)
MFA_DICTIONARY_PATH=/path/to/mfa/dictionary.txt

# CORS Allowed Origins (optional, defaults to all)
# For production, restrict to your frontend domain
# Example: CORS_ORIGIN=https://yourusername.github.io
CORS_ORIGIN=*

# Enable Debug Logging (optional, defaults to false)
DEBUG=false
